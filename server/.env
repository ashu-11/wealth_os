# Security
JWT_SECRET=wealthonex

# Database
# Paste your Atlas URI here to use persistent MongoDB locally.
# Example:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wealthos?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://wealthos_user:devuser2026@wealthonex.dlsmywb.mongodb.net/wealthos?retryWrites=true&w=majority&appName=wealthonex

JWT_EXPIRES_IN=7d

# Server
PORT=5050
NODE_ENV=development

# Claude AI (Anthropic API)
# Get your API key from https://console.anthropic.com/
# Without this, AI features will use mock/template responses
ANTHROPIC_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Azure AD OAuth (optional)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id
