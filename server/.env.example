# MongoDB (Atlas or local). Database name is the path segment (e.g. /wealthos).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/wealthos?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/wealthos

# JWT
JWT_SECRET=wealthos-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
# 5000 is often taken by macOS AirPlay; use 5050 locally if needed
PORT=5050
NODE_ENV=development

# Claude AI (Anthropic API)
# Get your API key from https://console.anthropic.com/
# Without this, AI features will use mock/template responses
ANTHROPIC_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Azure AD OAuth (optional)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id
